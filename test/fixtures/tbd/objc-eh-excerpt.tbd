--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-macos, arm64e-macos ]
install-name:    '/usr/lib/swift/libswiftCloudKit.dylib'
exports:
  - targets:         [ arm64-macos, arm64e-macos ]
    symbols:         [ _CKException, _CKRecord, _CKRecordID ]
    objc-eh-types:   [ CKException ]
    objc-ivars:      [ CKCodeProto2Any._typeUrl, CKCodeProto2Any._value, CKCodeProto2ProtectedEnvelope._contents, 
                       CKCodeProto2ProtectedEnvelope._has ]
...
