{
  "name": "macho-explorer",
  "version": "0.1.0",
  "type": "module",
  "description": "Mach-O binary introspection for Apple binaries: fat headers, symbol search, vaddr lookup, address-to-offset mapping, direct-call xrefs and byte-literal search. Zero dependencies, no build step — and it reads Mac binaries from Linux or Windows.",
  "keywords": [
    "mach-o",
    "macho",
    "universal-binary",
    "binary-analysis",
    "reverse-engineering",
    "arm64",
    "x86-64",
    "fat-binary",
    "symbol-table"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranjithrajv/MachO-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/ranjithrajv/MachO-explorer/issues"
  },
  "homepage": "https://github.com/ranjithrajv/MachO-explorer#readme",
  "author": "ranjithrajv",
  "license": "LGPL-3.0-or-later",
  "main": "src/api.mjs",
  "exports": {
    ".": "./src/api.mjs",
    "./macho": "./src/macho.mjs",
    "./fixtures": "./test/fixtures.mjs",
    "./package.json": "./package.json"
  },
  "types": "src/api.d.ts",
  "files": [
    "src",
    "test/fixtures.mjs",
    "test/fixtures",
    "schema",
    "man",
    "completions",
    "skill",
    "config.json",
    "COPYING",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "man": [
    "man/man1/describe.1",
    "man/man1/sym.1",
    "man/man1/symlookup.1",
    "man/man1/findcall.1",
    "man/man1/findliteral.1",
    "man/man1/mapliteral.1",
    "man/man1/a2o.1",
    "man/man1/o2a.1",
    "man/man1/disasm.1",
    "man/man1/mcp.1",
    "man/man1/audit.1",
    "man/man1/fingerprint.1",
    "man/man1/diff.1",
    "man/man1/overview.1"
  ],
  "bin": {
    "macho-explorer": "src/macho-explorer.mjs"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "test:fixtures": "node test/fixtures.mjs",
    "test:mutation": "node test/mutation-check.mjs",
    "test:mcp": "node test/mcp.mjs",
    "test:skill": "node test/skill.mjs",
    "test:types": "node test/types.mjs",
    "test:disasm": "node test/disasm.mjs",
    "test:publish": "node test/publish.mjs",
    "test:all": "npm run test:fixtures && npm test && npm run test:disasm && npm run test:mcp && npm run test:skill && npm run test:publish && npm run test:mutation"
  },
  "engines": {
    "node": ">=22.15"
  }
}
