{
  "name": "macho-explorer",
  "version": "0.1.0",
  "type": "module",
  "description": "Mach-O introspection for Apple binaries — fat headers, symbols, address↔offset mapping, direct-call xrefs, byte-literal search, a CI-gate audit and a rebuild-invariant diff. One auditable, dependency-free reader: no install, no build, no network, and it reads Mac binaries from Linux or Windows. The same file runs in a browser with no upload.",
  "keywords": [
    "mach-o",
    "macho",
    "universal-binary",
    "binary-analysis",
    "reverse-engineering",
    "arm64",
    "x86-64",
    "fat-binary",
    "symbol-table",
    "auditable",
    "zero-dependency",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranjithrajv/MachO-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/ranjithrajv/MachO-explorer/issues"
  },
  "homepage": "https://github.com/ranjithrajv/MachO-explorer#readme",
  "author": "ranjithrajv",
  "license": "LGPL-3.0-or-later",
  "main": "src/api.mjs",
  "exports": {
    ".": "./src/api.mjs",
    "./macho": "./src/macho.mjs",
    "./fixtures": "./test/fixtures.mjs",
    "./package.json": "./package.json"
  },
  "types": "src/api.d.ts",
  "files": [
    "src",
    "conformance",
    "demo",
    "docs",
    "test/fixtures.mjs",
    "test/fixtures",
    "schema",
    "man",
    "completions",
    "skill",
    "config.json",
    "COPYING",
    "LICENSE",
    "README.md",
    "AUDITABILITY.md",
    "CONTRIBUTING.md"
  ],
  "man": [
    "man/man1/describe.1",
    "man/man1/sym.1",
    "man/man1/symlookup.1",
    "man/man1/findcall.1",
    "man/man1/findliteral.1",
    "man/man1/mapliteral.1",
    "man/man1/a2o.1",
    "man/man1/o2a.1",
    "man/man1/dump.1",
    "man/man1/starts.1",
    "man/man1/assert.1",
