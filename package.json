    "findliteral": "src/findliteral.mjs",
    "mapliteral": "src/mapliteral.mjs",
    "a2o": "src/a2o.mjs",
    "o2a": "src/o2a.mjs",
    "dump": "src/dump.mjs",
    "starts": "src/starts.mjs",
    "assert": "src/assert.mjs",
    "disasm": "src/disasm.mjs",
    "mcp": "src/mcp.mjs",
